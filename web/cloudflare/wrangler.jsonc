{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "aera-web-jobs",
  "main": "./worker.mjs",
  "compatibility_date": "2026-11-21",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "AERA_JOB_SELF", "class_name": "GenerationJob" }]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GenerationJob"]
    }
  ]
}

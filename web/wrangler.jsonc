{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "aera-web",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-11-21",
  "durable_objects": {
    "bindings": [
      {
        "name": "AERA_JOBS",
        "class_name": "GenerationJob",
        "script_name": "aera-web-jobs"
      }
    ]
  }
}
